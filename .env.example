# ExperMate｜小同门：复制为 .env 后填写模型配置。
# 首次启动会迁移为 config.yaml；此后以 config.yaml 为准。
# 可在设置页切换其他 OpenAI 兼容服务商和模型。

LLM_AGENT_PROVIDER=deepseek
LLM_AGENT_API_KEY=sk-your-api-key-here
LLM_AGENT_MODEL=deepseek-v4-flash
LLM_ANALYZE_MODEL=deepseek-v4-pro
# 可选：将本机数据库、附件兼容文件、日志统一放到指定目录。
# DATA_DIR=./data
PORT=5000
GUI=true
